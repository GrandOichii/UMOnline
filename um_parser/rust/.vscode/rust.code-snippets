{
	"common godot imports": {
		"prefix": "usegd",
		"body": [
			"use godot::classes::*;",
			"use godot::prelude::*;",
			"",
			"$0",
		]
	},
	"godot node": {
		"prefix": "godotnode",
		"body": [
			"#[derive(GodotClass)]",
			"#[class(init,base=$1)]",
			"pub struct $2Node {",
			"\tbase: Base<$1>,",
			"",
			"\t//#[export_group(name=\"Nodes\")]",
			"\t",
			"}",
			"",
			"#[godot_api]",
			"impl I$1 for $2Node {",
			"\tfn ready(&mut self) {",
			"\t\tself.connect_signals();",
			"\t}",
			"}",
			"",
			"impl $2Node {",
			"\tfn connect_signals(&mut self) {",
			"\t",
			"\t}",
			"}",
		]
	},
	"export node": {
		"prefix": "exportnode",
		"body": [
			"#[export]",
			"${2:node_name}: OnEditor<Gd<$1>>,",
			"$0"
		]
	},
	"connect signal": {
		"prefix": "connectsignal",
		"body": [
			"self.${1:node_name}",
	        "    .signals()",
    	    "    .${2:signal_name}()",
        	"    .connect_other(self, Self::${3:signal_connection});",
		]
	}
}